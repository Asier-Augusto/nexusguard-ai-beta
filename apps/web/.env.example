# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL="postgresql://nexusguard:nexusguard_dev@localhost:5433/nexusguard?schema=public"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:3b-instruct"
AI_SERVICE_URL="http://localhost:8010"
NEXT_PUBLIC_AI_SERVICE_URL="http://localhost:8010"
# Direccion publica de la aplicacion. Es la que se escribe dentro del enlace
# instrumentado de cada senuelo de phishing, asi que en produccion tiene que
# ser la que ve el empleado, no localhost.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Secreto compartido con la pasarela que llama al webhook de phishing
# (/api/phishing/webhook). En un despliegue real NO se deja el de ejemplo:
# sin el, cualquiera que conociera un token podria marcar a un companero como
# "ha picado", y ese dato acaba en su Risk Score.
PHISHING_WEBHOOK_SECRET="nexusguard-webhook-dev"
